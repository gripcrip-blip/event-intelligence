# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/event_intelligence?schema=public

# PandaScore — register: https://app.pandascore.co/sign-up
# Token: Dashboard → https://app.pandascore.co/dashboard/main
PANDASCORE_API_TOKEN=
PANDASCORE_API_BASE_URL=https://api.pandascore.co
PANDASCORE_SYNC_PER_PAGE=50
PANDASCORE_SYNC_MAX_PAGES=5

# Auth (later)
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Redis / workers (later)
REDIS_URL=redis://localhost:6379

# Traditional sports providers (later)
FOOTBALL_DATA_API_KEY=
THESPORTSDB_API_KEY=
